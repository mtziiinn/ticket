# ── Conexão com o banco (compartilhada entre todos os clientes) ──
MONGO_URI=
# Nome do banco usado quando a requisição NÃO casa com nenhum tenant de TENANTS
# (mesmo valor do DATABASE_NAME do bot "principal", ex.: a Prism).
DATABASE_NAME=database

# ── Credenciais do cliente "principal" (fallback quando TENANTS não casa) ──
BOT_TOKEN=
API_KEY=
MP_ACCESS_TOKEN=
WEB_URL=

# ── Multi-cliente (multi-tenant) ──
# JSON: domínio -> { dbName, botToken, apiKey, mpAccessToken }.
# Cada cópia do bot aponta seu WEB_URL para um domínio; este deploy do web
# resolve o cliente pelo header Host. Domínios não listados caem no fallback acima.
# Exemplo (uma linha só na Vercel):
# TENANTS={"painel.prism.com":{"dbName":"database","botToken":"...","apiKey":"...","mpAccessToken":"..."},"painel.dusk.com":{"dbName":"dusksociety","botToken":"...","apiKey":"...","mpAccessToken":"..."}}
TENANTS=
